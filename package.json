{
  "name": "damas-mz",
  "version": "0.2.0",
  "description": "DAMAS MZ — plataforma de Damas Portuguesas online para Cloudflare",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:d1:migrate:local": "wrangler d1 migrations apply damas-mz --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply damas-mz --remote",
    "cf:types": "wrangler types"
  }
}
